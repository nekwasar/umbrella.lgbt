# Umbrella.lgbt API — local development environment
# Copy to .env and fill in. NEVER commit .env.

NODE_ENV=development
PORT=3000

# PostgreSQL (docker compose infra/docker-compose.yml uses these)
DATABASE_URL=postgresql://umbrella:umbrella@localhost:5432/umbrella

# Auth
JWT_SECRET=dev-secret-do-not-use-in-prod
JWT_EXPIRES_IN=7d

# CORS — the frontend origin
CORS_ORIGIN=http://localhost:3001

# Super admin (seeded in M1)
SUPERADMIN_USERNAME=admin
SUPERADMIN_PASSWORD=change-me
