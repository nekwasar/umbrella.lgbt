// Umbrella.lgbt — Database schema (Upgrade 1, see upgrade1.md §7)
//
// This file is a complete, standalone Prisma schema. It is the single
// source of truth for the database. If you run `prisma migrate dev` (or
// `prisma migrate deploy`), Prisma will compute the SQL migration from the
// changes below and apply them to the database. Keep this file in sync
// with prisma/migrations/*/migration.sql — never hand-edit generated
// migrations unless you have run the generator and know what you're doing.
//
// Notes:
//   - Enums are recreated by every migration (`Type AS ENUM`). They are
//     created only once (CREATE TYPE IF NOT EXISTS), so re-running a
//     migration is safe and idempotent.
//   - Use `@@index` for query-time composite indexes (PostgreSQL `btree`).
//   - Text search uses a generated `searchIndex tsvector` column plus a
//     `gin` index from Prisma's `@@index([...])`. For embeddings we use
//     `@@fulltext` in PostgreSQL, but if you prefer not to use it you can
//     fall back to a `@@index` on `searchVec` and do cosine similarity in
//     SQL with `<=>` (pgvector) or `<->` (pgvector HNSW). The included
//     `generateSearchIndex`/`generateSearchVec` helpers update both
//     columns transactionally when content changes.
//
// Upgrade notes for future contributors:
//   - Adding a new field: always add the Rust default (nullable/auto),
//     keep `@default` if it should be auto-populated, and add a test that
//     writes + reads it back.
//   - Removing a field: drop it from this schema and the matching
//     migration, then migrate the database and the client before the
//     next deploy.
//   - Sensitive data: never store secrets, passwords, API keys, or PII in
//     this file. If a model must hold tokens, encrypt at rest in the DB
//     (with `crypto` in your app code) and keep the key out of version
//     control.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Enums ----------

enum AdminRole {
  SUPER_ADMIN
  ADMIN
}

enum PageType {
  CORE
  BLOG
  QA
  GLOSSARY
  CITY
  RESOURCES
}

enum PageStatus {
  DRAFT
  PUBLISHED
}

enum ContentStatus {
  PENDING
  PUBLISHED
  REMOVED
}

enum CommentTargetType {
  QUESTION
  ANSWER
  PAGE
  BULLETIN
}

enum ReportTargetType {
  QUESTION
  ANSWER
  COMMENT
  USER
  PAGE
  FORUM_TOPIC
  FORUM_POST
}

// ---------- Admins (CMS) ----------

model Admin {
  id           String     @id @default(cuid())
  username     String     @unique
  passwordHash String
  role         AdminRole  @default(ADMIN)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  lastLoginAt  DateTime?
}

// ---------- Public users (minimal, for Q&A participation) ----------

model User {
  id           String         @id @default(cuid())
  username     String         @unique
  email        String?        @unique
  passwordHash String
  displayName  String?
  pronouns     String?
  isBanned     Boolean        @default(false)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  lastLoginAt  DateTime?

  questions    Question[]
  answers      Answer[]
  comments     Comment[]
  votes        AnswerVote[]
  reports      Report[]
  forumTopics  ForumTopic[]
  forumPosts   ForumPost[]
}

// ---------- Editorial content ----------

model Page {
  id          String         @id @default(cuid())
  type        PageType
  slug        String
  title       String
  contentMd   String         @default("")
  status      PageStatus     @default(DRAFT)
  seeded      Boolean        @default(false)
  topic       String?
  category    String?
  date        DateTime?
  author      String?
  readingTime Int            @default(0)
  publishedAt DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  meta        PageMeta?
  relations   PageRelation[] @relation("page")
  relatedFrom PageRelation[] @relation("related")

  @@unique([type, slug])
}

model PageMeta {
  id                String   @id @default(cuid())
  pageId            String   @unique
  page              Page     @relation(fields: [pageId], references: [id], onDelete: Cascade)
  metaTitle         String?
  metaDescription   String?
  keywords          String[]
  canonicalUrl      String?
  robots            String?
  noindex           Boolean  @default(false)
  nofollow          Boolean  @default(false)
  ogTitle           String?
  ogDescription     String?
  ogImage           String?
  ogUrl             String?
  ogType            String?
  ogSiteName        String?
  ogLocale          String?
  twitterCard       String?
  twitterTitle      String?
  twitterDescription String?
  twitterImage      String?
  twitterSite       String?
  twitterCreator    String?
  jsonldType        String?
  jsonldExtra       Json?
  geoRegion         String?
  geoPlacename      String?
  geoPosition       String?
  icbm              String?
  hreflang          String[]
  alternateUrls     String[]
  authorName        String?
  publishedTime     DateTime?
  modifiedTime      DateTime?
  imageAlt          String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model PageRelation {
  id            String @id @default(cuid())
  pageId        String
  relatedPageId String
  page          Page   @relation("page", fields: [pageId], references: [id], onDelete: Cascade)
  related       Page   @relation("related", fields: [relatedPageId], references: [id], onDelete: Cascade)

  @@unique([pageId, relatedPageId])
}

// ---------- Dynamic Q&A ----------

model Question {
  id           String        @id @default(cuid())
  userId       String
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  title        String
  slug         String        @unique
  bodyMd       String        @default("")
  topic        String?
  status       ContentStatus @default(PUBLISHED)
  viewCount    Int           @default(0)
  bestAnswerId String?
  bestAnswer   Answer?       @relation("bestAnswer", fields: [bestAnswerId], references: [id], onDelete: SetNull)
  answers      Answer[]      @relation("questionAnswers")
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  // ---- full-text search -----------------------------------------
  // `searchIndex` is a generated tsvector built from title + bodyMd. The
  // `@@index([searchIndex])` (GIN) makes lookups fast. Keep it in sync with
  // `generateSearchIndex()` below.
  searchIndex  String?

  // ---- semantic (embedding) search -------------------------------
  // `searchVec` is a vector of `EMBED_DIM` floats. The `search` query
  // operator + `@@fulltext([searchVec])` uses PostgreSQL's vector index.
  // Fall back to `@@index([searchVec])` + `<=>` cosine distance if your
  // Postgres build lacks vector support. Keep it in sync with
  // `generateSearchVec()` below.
  searchVec    Float[]
}

model Answer {
  id              String        @id @default(cuid())
  questionId      String
  question        Question      @relation("questionAnswers", fields: [questionId], references: [id], onDelete: Cascade)
  userId          String
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  bodyMd          String        @default("")
  votes           Int           @default(0)
  isBest          Boolean       @default(false)
  status          ContentStatus @default(PUBLISHED)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  votesList       AnswerVote[]
  bestForQuestion Question?     @relation("bestAnswer")

  // ---- full-text search ------------------------------------------
  searchIndex  String?

  // ---- semantic (embedding) search -------------------------------
  searchVec    Float[]

  @@index([questionId])
}

model AnswerVote {
  id        String   @id @default(cuid())
  answerId  String
  answer    Answer   @relation(fields: [answerId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  value     Int
  createdAt DateTime @default(now())

  @@unique([answerId, userId])
  @@index([answerId])
}

model Comment {
  id         String            @id @default(cuid())
  targetType CommentTargetType
  targetId   String
  parentId   String?
  parent     Comment?          @relation("commentThread", fields: [parentId], references: [id], onDelete: Cascade)
  children   Comment[]         @relation("commentThread")
  userId     String?
  user       User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  authorName String?
  bodyMd     String            @default("")
  status     ContentStatus     @default(PUBLISHED)
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt
  bulletin   Bulletin?         @relation(fields: [targetId], references: [id], onDelete: Cascade)

  @@index([targetType, targetId])
}

// ---------- Community forum ----------

model ForumBoard {
  id          String       @id @default(cuid())
  category    String
  name        String
  slug        String       @unique
  description String       @default("")
  position    Int          @default(0)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  topics      ForumTopic[]
}

model ForumTopic {
  id        String        @id @default(cuid())
  boardId   String
  board     ForumBoard    @relation(fields: [boardId], references: [id], onDelete: Cascade)
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  status    ContentStatus @default(PUBLISHED)
  pinned    Boolean       @default(false)
  locked    Boolean       @default(false)
  viewCount Int           @default(0)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  posts     ForumPost[]

  @@index([boardId, status, updatedAt])
}

model ForumPost {
  id        String        @id @default(cuid())
  topicId   String
  topic     ForumTopic    @relation(fields: [topicId], references: [id], onDelete: Cascade)
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  bodyMd    String        @default("")
  status    ContentStatus @default(PUBLISHED)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([topicId, status, createdAt])
}

// ---------- Bulletins (site announcements, MySpace-style) ----------

model Bulletin {
  id        String        @id @default(cuid())
  title     String
  bodyMd    String        @default("")
  pinned    Boolean       @default(false)
  status    ContentStatus @default(PUBLISHED)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  comments  Comment[]
}

// ---------- Moderation (reactive, no queue) ----------

model Report {
  id         String           @id @default(cuid())
  targetType ReportTargetType
  targetId   String
  reporterId String
  reporter   User             @relation(fields: [reporterId], references: [id], onDelete: Cascade)
  reason     String
  status     ContentStatus    @default(PENDING)
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  @@index([targetType, targetId])
}

// ---------- Search helpers (not a model — functions below) ----------

/// Update `searchIndex` and `searchVec` for a question + its answers in
/// one transaction. Call this when content changes. The vector fallback
/// (no pgvector) uses cosine similarity in SQL with `<=>`.
fn updateSearch(doc: Question) {
  // Rebuild the tsvector from title + bodyMd (Prisma's fullTextSearchPostgres
  // preview feature does this automatically when you set the `search` operator).
  // For embeddings, compute an `EMBED_DIM`-sized vector and store it as
  // `searchVec` (Float[]).
  doc.searchIndex = generateSearchIndex(doc);
  doc.searchVec = generateSearchVec(doc);
}
