# Umbrella.lgbt — production infrastructure env
# Copy to infra/.env and fill in real values. NEVER commit .env.

# --- PostgreSQL ---
POSTGRES_USER=umbrella
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=umbrella

# --- API ---
# Used by docker-compose as the api service DATABASE_URL (host `db`).
# NOTE: if you also run the api locally, use apps/api/.env with localhost:5432
JWT_SECRET=CHANGE_ME_LONG_RANDOM_STRING
JWT_EXPIRES_IN=7d
CORS_ORIGIN=https://umbrella.lgbt
SUPERADMIN_USERNAME=admin
SUPERADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD

# --- Caddy / proxy ---
# Public hostname that should point (DNS A record) at this VPS.
API_DOMAIN=api.umbrella.lgbt
